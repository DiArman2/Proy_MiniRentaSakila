@model List<MiniRentaSakila.Models.PeliculaAlquilerViewModel>

@{
    ViewData["Title"] = "Películas más alquiladas";
    int posicion = 1;
}

<div class="mt-4">

    <div class="mb-3">
        <h1 class="mb-1">Películas más alquiladas</h1>
        <p class="text-muted mb-0">Las 10 películas con mayor cantidad de alquileres.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Película</th>
                            <th>Cantidad de alquileres</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pelicula in Model)
                        {
                            <tr>
                                <td>@(posicion++)</td>
                                <td>@pelicula.Titulo</td>
                                <td>@pelicula.CantidadAlquileres</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>